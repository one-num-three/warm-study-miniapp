.mistake { display: grid; grid-template-columns: 66rpx 1fr auto; gap: 15rpx; align-items: start; }.mistake-symbol { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; color: #fff9ed; font-size: 30rpx; font-weight: 800; background: #d86f45; border-radius: 6rpx 22rpx 22rpx 22rpx; }.mistake-copy text { display: block; }.mistake-copy text:first-child { color: #c86742; font-size: 20rpx; }.mistake-copy text:nth-child(2) { margin: 5rpx 0; font-size: 27rpx; font-weight: 800; }.mistake-copy text:last-child { color: #728076; font-size: 21rpx; line-height: 1.55; }.advance { display: block; margin-top: 12rpx; color: #2f5b45; font-size: 21rpx; text-decoration: underline; }
