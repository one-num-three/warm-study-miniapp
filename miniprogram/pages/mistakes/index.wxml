<view class="page">
  <text class="eyebrow">错题集</text><text class="title">错过一次，也可以学会一次</text><text class="subtitle">把错因和订正方法留下来，下一次就有更清晰的方向。</text>
  <scroll-view scroll-x class="chip-row"><button wx:for="{{students}}" wx:key="id" class="chip {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectStudent">{{item.nickname}}</button></scroll-view>
  <view class="card"><text class="form-label">科目</text><picker class="picker" range="{{subjects}}" value="{{subjectIndex}}" bindchange="subjectChange">{{subjects[subjectIndex]}}</picker><text class="form-label">知识点</text><input class="input" placeholder="例如：分数应用题" value="{{knowledge}}" data-field="knowledge" bindinput="input" /><text class="form-label">错因与订正提示</text><textarea class="textarea" placeholder="为什么会错，下次怎么避免" value="{{note}}" data-field="note" bindinput="input" /><button class="soft upload" bindtap="chooseImage">{{image ? '已选择错题图片' : '选择错题图片（可选）'}}</button><button class="primary submit" bindtap="submit">保存到错题集</button></view>
  <view class="section-title"><text>错题记录</text></view><view wx:if="{{!list.length}}" class="empty">还没有错题记录。</view><view wx:for="{{list}}" wx:key="id" class="card mistake"><view class="mistake-symbol">错</view><view class="mistake-copy"><text>{{state.role === 'guardian' ? item.subject : item.studentName + ' · ' + item.subject}}</text><text>{{item.knowledge}}</text><text>{{item.note}}</text></view><view><text class="status {{item.status === '待订正' ? 'wait' : ''}}">{{item.status}}</text><button wx:if="{{state.role !== 'guardian'}}" class="advance" data-id="{{item.id}}" bindtap="advance">推进状态</button></view></view>
</view>
