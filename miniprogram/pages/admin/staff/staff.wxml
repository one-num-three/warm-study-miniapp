<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <!-- 老师直接进这一页会拿到 FORBIDDEN，原话显示出来，不留白屏 -->
  <view class="error-box" wx:elif="{{error}}">
    <text class="error-box__text">{{error}}</text>
    <view class="btn btn--sm" bindtap="load" hover-class="btn--hover">重新加载</view>
  </view>

  <block wx:else>
    <view
      wx:if="{{canManage}}"
      class="btn btn--primary btn--block staff__create"
      bindtap="onCreateStaff"
      hover-class="btn--hover"
    >
      新增老师
    </view>

    <view class="empty" wx:if="{{staff.length === 0}}">还没有账号</view>

    <block wx:else>
      <view class="card" wx:for="{{staff}}" wx:key="id" wx:for-item="item" wx:for-index="index">
        <view class="card__title">
          <text>{{item.titleText}}</text>
          <text class="{{item.tagClass}}">{{item.tagText}}</text>
        </view>
        <view class="row__sub">{{item.subText}}</view>

        <!-- 权限平铺：负责人一眼就能看出这个人能不能碰钱、能不能改设置 -->
        <view class="staff__perms" wx:if="{{item.permissionLabels.length > 0}}">
          <text class="tag tag--muted" wx:for="{{item.permissionLabels}}" wx:key="*this" wx:for-item="label">{{label}}</text>
          <text class="tag tag--muted" wx:if="{{item.permissionRestText}}">{{item.permissionRestText}}</text>
        </view>

        <view class="btn-row staff__actions" wx:if="{{canManage && !item.isOwner}}">
          <view
            class="{{item.statusBtnClass}}"
            data-index="{{index}}"
            bindtap="onToggleStatus"
            hover-class="btn--hover"
          >
            {{item.statusBtnText}}
          </view>
          <view class="btn btn--sm" data-index="{{index}}" bindtap="onResetPassword" hover-class="btn--hover">
            重设密码
          </view>
        </view>

        <!-- 负责人账号没有停用入口：系统必须留住最后一名负责人 -->
        <view class="card__hint staff__actions" wx:elif="{{item.isOwner}}">
          系统始终保留至少一名负责人，不能停用最后一名。
        </view>
      </view>
    </block>
  </block>

  <form-modal
    show="{{formShow}}"
    title="{{formTitle}}"
    hint="{{formHint}}"
    fields="{{formFields}}"
    submitText="{{formSubmitText}}"
    bind:submit="onFormSubmit"
    bind:cancel="onFormCancel"
  />
</view>
