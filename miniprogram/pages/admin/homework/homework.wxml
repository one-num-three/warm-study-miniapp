<view class="page page--tabbed">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="error-box" wx:elif="{{error}}">
    <text class="error-box__text">{{error}}</text>
    <view class="btn btn--sm" bindtap="load" hover-class="btn--hover">重新加载</view>
  </view>

  <block wx:else>
    <view class="empty" wx:if="{{sheets.length === 0}}">今天还没有家长提交作业</view>

    <view class="card" wx:for="{{sheets}}" wx:key="id" wx:for-item="sheet" wx:for-index="sheetIndex">
      <view class="spread full">
        <view class="homework__name">{{sheet.studentName}}</view>
        <text class="{{sheet.tone}}">{{sheet.status}}</text>
      </view>

      <!-- 一项一行：左边缩略图（家长拍的作业照），中间科目和补充说明，右边推进按钮 -->
      <view class="row" wx:for="{{sheet.items}}" wx:key="id" wx:for-item="item" wx:for-index="itemIndex">
        <image wx:if="{{item.image}}" class="thumb thumb--sm" src="{{item.image}}" mode="aspectFill" />
        <view class="row__main">
          <view class="row__title">{{item.subject}}</view>
          <view class="row__sub">{{item.content}}</view>
        </view>

        <view class="btn-row" wx:if="{{item.actions.length > 0}}">
          <view
            class="btn btn--sm"
            wx:for="{{item.actions}}"
            wx:key="to"
            wx:for-item="action"
            wx:for-index="actionIndex"
            data-item="{{item.id}}"
            data-to="{{action.to}}"
            bindtap="onItemStatus"
            hover-class="btn--hover"
          >
            {{action.label}}
          </view>
        </view>
        <!-- 已终结的项，或没有处理权限时，只给一个只读标签 -->
        <text wx:else class="{{item.tagClass}}">{{item.status}}</text>
      </view>

      <view class="card__hint homework__feedback" wx:if="{{sheet.feedback}}">反馈：{{sheet.feedback}}</view>

      <view class="btn-row homework__actions" wx:if="{{sheet.canFinish}}">
        <view
          class="{{sheet.finishClass}}"
          data-index="{{sheetIndex}}"
          bindtap="onFinish"
          hover-class="btn--hover"
        >
          结束今天的作业
        </view>
      </view>

      <block wx:if="{{sheet.canAskMore}}">
        <view class="btn-row homework__actions">
          <view
            class="btn btn--sm btn--ghost"
            data-sheet="{{sheet.id}}"
            bindtap="onAskMore"
            hover-class="btn--hover"
          >
            要求补充
          </view>
        </view>
        <view class="card__hint">把任意一项标记为「开始」，整张单会自动进入辅导中。</view>
      </block>
    </view>
  </block>

  <form-modal
    show="{{formShow}}"
    title="{{formTitle}}"
    hint="{{formHint}}"
    fields="{{formFields}}"
    submitText="{{formSubmitText}}"
    bind:submit="onFormSubmit"
    bind:cancel="onFormCancel"
  />
</view>

<tab-bar active="{{1}}" role="admin"></tab-bar>
