/* 现场兑换的私有样式。骨架（.card / .tag / .btn / .spread）都来自 app.wxss，这里只补价格和间距。 */

/* 价格用陶土色大字：柜台前老师扫一眼就要读到"多少分"，它比商品名更需要被看见 */
.redeem__cost {
  color: #d86f45;
  font-size: 34rpx;
  font-weight: 700;
}

/* 说明文字和价格行之间要断开，否则挤成一坨 */
.redeem__foot {
  margin-top: 16rpx;
}

/* 无权限提示紧跟在操作说明下面，单独留一点行距区分两句话 */
.redeem__notice {
  margin-top: 12rpx;
}
