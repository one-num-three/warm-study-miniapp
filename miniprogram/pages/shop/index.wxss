.product { display: grid; grid-template-columns: 100rpx 1fr; gap: 18rpx; align-items: center; }.product-art { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; color: #2f5b45; font-size: 44rpx; font-weight: 800; background: #fff0bd; border-radius: 46% 54% 47% 53%; }.product-copy text { display: block; }.product-copy text:first-child { font-size: 30rpx; font-weight: 800; }.product-copy text:nth-child(2) { margin-top: 7rpx; color: #2f5b45; font-size: 32rpx; font-weight: 800; }.product-copy text:last-child { margin-top: 5rpx; color: #728076; font-size: 21rpx; }.product-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }.small-button { min-height: 60rpx; padding: 14rpx 16rpx; color: #526359; font-size: 22rpx; background: #f3ead8; border-radius: 12rpx; }.record text { display: block; }.record text:first-child { font-size: 26rpx; font-weight: 800; }.record text:last-child { margin-top: 6rpx; color: #728076; font-size: 22rpx; }
