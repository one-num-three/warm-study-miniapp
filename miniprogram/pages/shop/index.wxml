<view class="page">
  <text class="eyebrow">积分商店</text><text class="title">{{state.role === 'guardian' ? '喜欢的奖励，靠努力慢慢兑换' : '把孩子的努力换成一份实在的鼓励'}}</text><text class="subtitle">{{state.role === 'guardian' ? '到辅导班后请老师帮忙办理兑换。' : '兑换时会同步扣积分、减库存并保留记录。'}}</text>
  <scroll-view wx:if="{{state.role !== 'guardian'}}" scroll-x class="chip-row"><button wx:for="{{students}}" wx:key="id" class="chip {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectStudent">{{item.nickname}} · {{item.points}}分</button></scroll-view>
  <view wx:for="{{products}}" wx:key="id" class="card product">
    <view class="product-art">{{item.initial}}</view>
    <view class="product-copy"><text>{{item.name}}</text><text>{{item.cost}} 积分</text><text>{{item.onSale ? '可兑换' : '已下架'}} · 库存 {{item.stock}}</text></view>
    <view class="product-actions"><button wx:if="{{state.role !== 'guardian'}}" class="soft" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="redeem">现场兑换</button><text wx:else class="muted">现场找老师兑换</text><block wx:if="{{state.role === 'owner'}}"><button class="small-button" data-id="{{item.id}}" bindtap="toggleSale">{{item.onSale ? '下架' : '上架'}}</button><button class="small-button" data-id="{{item.id}}" bindtap="addStock">库存+1</button></block></view>
  </view>
  <view wx:if="{{state.role === 'owner'}}" class="card"><text class="form-label">上架新商品</text><input class="input" placeholder="商品名称" value="{{productName}}" data-field="productName" bindinput="input" /><input class="input" type="number" placeholder="所需积分" value="{{productCost}}" data-field="productCost" bindinput="input" /><input class="input" type="number" placeholder="初始库存" value="{{productStock}}" data-field="productStock" bindinput="input" /><button class="primary submit" bindtap="addProduct">确认上架</button></view>
  <view wx:if="{{state.role !== 'guardian'}}" class="section-title"><text>最近兑换</text></view><view wx:if="{{state.role !== 'guardian' && !redemptions.length}}" class="empty">今天还没有兑换记录。</view><view wx:for="{{redemptions}}" wx:key="id" class="card record"><text>{{item.studentName}} · {{item.productName}}</text><text>{{item.cost}} 分 · {{item.status}} · {{item.at}}</text><button wx:if="{{state.role === 'owner' && item.status === '已完成'}}" class="reverse" data-id="{{item.id}}" bindtap="reverse">撤销兑换</button></view>
</view>
