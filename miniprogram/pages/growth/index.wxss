.growth-card { display: flex; flex-direction: column; gap: 8rpx; margin-top: 16rpx; padding: 34rpx; color: #fff9ed; background: #d86f45; border-radius: 14rpx 48rpx 14rpx 48rpx; }.growth-card text:nth-child(1), .growth-card text:nth-child(3) { font-size: 23rpx; }.growth-card text:nth-child(2) { color: #fff0bd; font-size: 78rpx; font-weight: 800; line-height: 1; }.rank { display: flex; align-items: center; gap: 18rpx; }.rank text:first-child { display: flex; justify-content: center; align-items: center; width: 42rpx; height: 42rpx; background: #fff0bd; border-radius: 50%; }.rank text:nth-child(2) { flex: 1; font-size: 27rpx; font-weight: 700; }.rank text:last-child { color: #2f5b45; font-weight: 800; }.ledger { display: flex; justify-content: space-between; align-items: center; }.ledger view:first-child text { display: block; }.ledger view:first-child text:first-child { font-size: 26rpx; font-weight: 800; }.ledger view:first-child text:last-child { margin-top: 7rpx; color: #728076; font-size: 21rpx; }.plus, .minus { padding: 10rpx; border-radius: 10rpx; }.plus { color: #2f5b45; background: #dfeedd; }.minus { color: #9b482c; background: #fde2d4; }.reverse { display: block; margin-top: 10rpx; color: #2f5b45; font-size: 21rpx; text-decoration: underline; }
