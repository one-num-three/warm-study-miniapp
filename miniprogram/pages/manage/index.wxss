.binding, .permission { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.binding view:first-child, .permission view { flex: 1; }.binding text, .permission text { display: block; }.binding text:first-child, .permission text:first-child { font-size: 27rpx; font-weight: 800; }.binding text:nth-child(2), .permission text:nth-child(2) { margin-top: 7rpx; color: #728076; font-size: 21rpx; line-height: 1.5; }.text-action { display: block; margin-top: 10rpx; color: #2f5b45; font-size: 21rpx; text-decoration: underline; }.permission > text { padding: 10rpx 14rpx; color: #2f5b45; font-size: 21rpx; background: #e7efdf; border-radius: 10rpx; }.security { background: #fff0bd; }.security text { display: block; }.security text:first-child { color: #7e5b11; font-size: 26rpx; font-weight: 800; }.security text:last-child { margin-top: 8rpx; color: #6a5741; font-size: 22rpx; line-height: 1.6; }.audit { display: grid; grid-template-columns: 110rpx 1fr; gap: 15rpx; }.audit > text { color: #c86742; font-size: 20rpx; font-weight: 700; }.audit view text { display: block; }.audit view text:first-child { font-size: 25rpx; font-weight: 800; }.audit view text:last-child { margin-top: 6rpx; color: #728076; font-size: 21rpx; line-height: 1.5; }
