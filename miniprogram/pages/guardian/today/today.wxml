<view class="page page--tabbed">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="error-box" wx:elif="{{error}}">
    <text class="error-box__text">{{error}}</text>
    <view class="btn btn--sm" bindtap="load" hover-class="btn--hover">重新加载</view>
  </view>

  <!-- 还没绑孩子：整页只放引导，别让家长对着空数据发愣 -->
  <block wx:elif="{{noStudent}}">
    <view class="card">
      <view class="card__title">还没有绑定孩子</view>
      <view class="card__hint">向辅导班老师要一张写着绑定码的小卡片，输入后就能看到孩子在班里的情况。</view>
      <view class="btn btn--primary btn--block today__bind" bindtap="goBind" hover-class="btn--hover">去输绑定码</view>
    </view>

    <view class="card" wx:if="{{pendings.length > 0}}">
      <view class="card__title">等待审核</view>
      <view class="row" wx:for="{{pendings}}" wx:key="key">
        <view class="row__main">
          <view class="row__title">{{item.studentName}}</view>
          <view class="row__sub">{{item.sub}}</view>
        </view>
        <text class="tag tag--gold">待审核</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 多孩家庭的切换条 -->
    <view class="picker" wx:if="{{showPicker}}">
      <view
        wx:for="{{pickerItems}}"
        wx:key="id"
        class="{{item.cls}}"
        data-id="{{item.id}}"
        bindtap="onPickStudent"
      >
        {{item.label}}
      </view>
    </view>

    <view class="hero">
      <view class="hero__label">{{heroLabel}}</view>
      <view class="hero__value">{{balance}}</view>
      <view class="hero__foot">
        <view>{{gradeText}}</view>
        <view>{{relationText}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card__title">今天在班里</view>

      <view class="row">
        <view class="row__main">
          <view class="row__title">{{sheetTitle}}</view>
          <view class="row__sub">{{sheetSub}}</view>
        </view>
        <view wx:if="{{todaySheetId}}" class="btn btn--sm" bindtap="openTodaySheet" hover-class="btn--hover">查看</view>
        <view wx:else class="btn btn--sm btn--primary" bindtap="goSubmit" hover-class="btn--hover">去提交</view>
      </view>

      <view class="row">
        <view class="row__main">
          <view class="row__title">{{reminderTitle}}</view>
          <view class="row__sub">{{reminderSub}}</view>
        </view>
        <text wx:if="{{reminderStatus}}" class="{{reminderTone}}">{{reminderStatus}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card__title">
        <text>最近积分</text>
        <view class="btn btn--sm" bindtap="goLedger" hover-class="btn--hover">全部</view>
      </view>

      <view class="empty" wx:if="{{entries.length === 0}}">还没有积分记录</view>
      <block wx:else>
        <view class="row" wx:for="{{entries}}" wx:key="id">
          <view class="row__main">
            <view class="{{item.titleClass}}">{{item.reason}}</view>
            <view class="row__sub">{{item.sub}}</view>
          </view>
          <view class="{{item.deltaClass}}">{{item.deltaText}}</view>
        </view>
      </block>
    </view>
  </block>
</view>
