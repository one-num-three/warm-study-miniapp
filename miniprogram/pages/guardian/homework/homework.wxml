<view class="page page--tabbed">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="error-box" wx:elif="{{error}}">
    <text class="error-box__text">{{error}}</text>
    <view class="btn btn--sm" bindtap="load" hover-class="btn--hover">重新加载</view>
  </view>

  <!-- 还没绑孩子：整页只放引导 -->
  <block wx:elif="{{noStudent}}">
    <view class="card">
      <view class="card__title">还没有绑定孩子</view>
      <view class="card__hint">向辅导班老师要一张写着绑定码的小卡片，输入后就能看到孩子在班里的情况。</view>
      <view class="btn btn--primary btn--block homework__bind" bindtap="goBind" hover-class="btn--hover">去输绑定码</view>
    </view>

    <view class="card" wx:if="{{pendings.length > 0}}">
      <view class="card__title">等待审核</view>
      <view class="row" wx:for="{{pendings}}" wx:key="key">
        <view class="row__main">
          <view class="row__title">{{item.studentName}}</view>
          <view class="row__sub">{{item.sub}}</view>
        </view>
        <text class="tag tag--gold">待审核</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 多孩家庭的切换条 -->
    <view class="picker" wx:if="{{showPicker}}">
      <view
        wx:for="{{pickerItems}}"
        wx:key="id"
        class="{{item.cls}}"
        data-id="{{item.id}}"
        bindtap="onPickStudent"
      >
        {{item.label}}
      </view>
    </view>

    <view class="btn btn--primary btn--block homework__submit" bindtap="goSubmit" hover-class="btn--hover">
      提交今天的作业
    </view>

    <view class="empty" wx:if="{{sheets.length === 0}}">还没有作业记录</view>

    <view class="card" wx:for="{{sheets}}" wx:key="id">
      <view class="card__title">
        <text>{{item.dateKey}}</text>
        <text class="{{item.tone}}">{{item.status}}</text>
      </view>

      <view class="row__sub">{{item.summary}}</view>

      <view class="card__hint homework__feedback" wx:if="{{item.feedback}}">{{item.feedbackText}}</view>

      <view
        class="btn btn--sm homework__detail"
        data-id="{{item.id}}"
        bindtap="openSheet"
        hover-class="btn--hover"
      >
        查看详情
      </view>
    </view>
  </block>
</view>
