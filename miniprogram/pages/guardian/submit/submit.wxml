<view class="page">
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="error-box" wx:elif="{{error}}">
    <text class="error-box__text">{{error}}</text>
    <view class="btn btn--sm" bindtap="load" hover-class="btn--hover">重新加载</view>
  </view>

  <!-- 还没绑孩子就没有可提交的对象 -->
  <block wx:elif="{{noStudent}}">
    <view class="card">
      <view class="card__title">还没有绑定孩子</view>
      <view class="card__hint">向辅导班老师要一张写着绑定码的小卡片，输入后就能看到孩子在班里的情况。</view>
      <view class="btn btn--primary btn--block submit__bind" bindtap="goBind" hover-class="btn--hover">去输绑定码</view>
    </view>

    <view class="card" wx:if="{{pendings.length > 0}}">
      <view class="card__title">等待审核</view>
      <view class="row" wx:for="{{pendings}}" wx:key="key">
        <view class="row__main">
          <view class="row__title">{{item.studentName}}</view>
          <view class="row__sub">{{item.sub}}</view>
        </view>
        <text class="tag tag--gold">待审核</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="card__title">{{headTitle}}</view>
      <view class="card__hint">按科目一项一项加，老师会逐项标记进度。作业开始辅导后就不能再改了。</view>
    </view>

    <view class="card">
      <view class="card__title">今天的作业</view>

      <view class="empty" wx:if="{{items.length === 0}}">还没有添加科目</view>
      <block wx:else>
        <view class="row" wx:for="{{items}}" wx:key="key">
          <image wx:if="{{item.image}}" class="thumb thumb--sm" src="{{item.image}}" mode="aspectFill" />
          <view class="row__main">
            <view class="row__title">{{item.subject}}</view>
            <view class="row__sub">{{item.contentText}}</view>
          </view>
          <view
            class="btn btn--sm btn--ghost"
            data-index="{{index}}"
            bindtap="onRemoveItem"
            hover-class="btn--hover"
          >
            删除
          </view>
        </view>
      </block>
    </view>

    <view class="btn btn--block submit__add" bindtap="onAddItem" hover-class="btn--hover">添加一项</view>

    <view
      class="btn btn--primary btn--block {{submitting ? 'is-disabled' : ''}}"
      bindtap="onSubmit"
      hover-class="btn--hover"
    >
      {{submitting ? '提交中…' : '提交给老师'}}
    </view>
  </block>

  <form-modal
    show="{{formShow}}"
    title="{{formTitle}}"
    hint="{{formHint}}"
    fields="{{formFields}}"
    submitText="{{formSubmitText}}"
    bind:submit="onFormSubmit"
    bind:cancel="onFormCancel"
  />
</view>
