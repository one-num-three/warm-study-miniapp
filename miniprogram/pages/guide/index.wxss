.route { display: grid; gap: 12rpx; margin: 28rpx 0; }.route view { display: grid; grid-template-columns: 52rpx 1fr; gap: 6rpx 14rpx; padding: 20rpx; background: #e7efdf; border-radius: 12rpx 30rpx 30rpx 30rpx; }.route view:nth-child(2) { background: #fff0bd; }.route view:nth-child(3) { color: #fff9ed; background: #2f5b45; }.route text:first-child { grid-row: span 2; color: #c86742; font-size: 30rpx; font-weight: 800; }.route view:nth-child(3) text:first-child { color: #fff0bd; }.route text:nth-child(2) { font-size: 27rpx; font-weight: 800; }.route text:nth-child(3) { color: #68776c; font-size: 22rpx; }.route view:nth-child(3) text:nth-child(3) { color: #e6d8b9; }.guide-card text { display: block; }.guide-card text:first-child { color: #2f5b45; font-size: 30rpx; font-weight: 800; }.guide-card text:nth-child(2) { min-height: 70rpx; margin: 10rpx 0 18rpx; color: #68776c; font-size: 23rpx; line-height: 1.6; }.note { background: #fff0bd; }.note text { display: block; }.note text:first-child { color: #7e5b11; font-size: 27rpx; font-weight: 800; }.note text:last-child { margin-top: 8rpx; color: #6a5741; font-size: 22rpx; line-height: 1.65; }
