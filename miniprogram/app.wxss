/**
 * 全局样式 —— 从 h5/src/styles.css 移植而来，px 按 375 设计稿换算成 rpx（1px = 2rpx）。
 *
 * 两端共用同一套设计令牌（深绿主色 / 暖米卡片 / 陶土强调），
 * 目的是让家长在 H5 和小程序里看到的是同一个产品，而不是两个像素级不同的界面。
 *
 * 刻意不引外部字体：小程序包体装不下中文字体子集（design.md §4.4），
 * 统一降级到平台默认中文字体，和 H5 保持一致。
 */

page {
  /* 主色 —— 深绿，取自原型 */
  --c-primary: #2f5b45;
  --c-primary-soft: #e7efdf;
  --c-primary-ink: #1e3c2d;
  /* 强调 —— 陶土红 / 暖黄 */
  --c-accent: #d86f45;
  --c-gold: #e8b44a;
  /* 背景层次 */
  --c-bg: #efe9dc;
  --c-surface: #fffaf0;
  --c-surface-2: #f7f0df;
  --c-line: #e3d8c2;
  /* 文字 */
  --c-ink: #27332d;
  --c-ink-2: #6b7a6f;
  --c-ink-3: #9aa79d;
  /* 语义色 */
  --c-danger: #c0442f;
  --c-success: #3d7a52;
  --c-warn: #b8801f;

  --r-sm: 16rpx;
  --r-md: 28rpx;
  --r-lg: 40rpx;

  /* TabBar 高度（含安全区在各处单独加） */
  --tabbar-h: 112rpx;

  background: #efe9dc;
  color: #27332d;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

/* --------------------------------- 页面容器 --------------------------------- */

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 40rpx;
  background: var(--c-bg);
}

/* 有自定义 TabBar 的页面要给底部留位置，否则最后一张卡片会被挡住。
   这里写死 200rpx（TabBar 112rpx + 留白）而不是 calc(var(--tabbar-h) + …)：
   rpx 在 calc() 里要靠 WXSS 运行时换算，少嵌一层变量就少一层出错的可能。 */
.page--tabbed {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* --------------------------------- 卡片 --------------------------------- */

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: var(--c-surface);
  border: 2rpx solid var(--c-line);
  border-radius: var(--r-lg);
}

.card--flat {
  background: var(--c-surface-2);
}

.card__title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.card__hint {
  color: var(--c-ink-2);
  font-size: 24rpx;
  line-height: 1.7;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 36rpx 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--c-ink-2);
  letter-spacing: 0.06em;
}

/* -------------------------- 空态 / 加载态 / 错误态 -------------------------- */

.empty {
  padding: 56rpx 32rpx;
  color: var(--c-ink-3);
  font-size: 26rpx;
  text-align: center;
}

.loading {
  padding: 80rpx 0;
  color: var(--c-ink-3);
  font-size: 26rpx;
  text-align: center;
}

/* 页面级错误：比 toast 更持久，因为用户需要看到「重试」按钮 */
.error-box {
  padding: 40rpx 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
  background: #f7dcd7;
  border-radius: var(--r-lg);
}

.error-box__text {
  display: block;
  margin-bottom: 20rpx;
  color: var(--c-danger);
  font-size: 26rpx;
  line-height: 1.7;
}

/* --------------------------------- 按钮 --------------------------------- */
/* 用 view 而不是 button：小程序原生 button 自带一堆改不掉的样式和边框 */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-primary);
  background: var(--c-primary-soft);
  border-radius: var(--r-md);
}

.btn--hover {
  opacity: 0.82;
}

.btn--primary {
  color: #fdf8ec;
  background: var(--c-primary);
}

.btn--accent {
  color: #fff;
  background: var(--c-accent);
}

.btn--ghost {
  color: var(--c-ink-2);
  background: transparent;
  border: 2rpx solid var(--c-line);
}

.btn--danger {
  color: #fff;
  background: var(--c-danger);
}

.btn--block {
  display: flex;
  width: 100%;
}

.btn--sm {
  min-height: 60rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.btn.is-disabled {
  opacity: 0.45;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* --------------------------------- 标签 --------------------------------- */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--c-primary);
  background: var(--c-primary-soft);
  border-radius: 999rpx;
  white-space: nowrap;
}

.tag--gold {
  color: var(--c-warn);
  background: #fbf0d5;
}

.tag--accent {
  color: var(--c-accent);
  background: #fae2d8;
}

.tag--muted {
  color: var(--c-ink-2);
  background: #ebe6da;
}

.tag--danger {
  color: var(--c-danger);
  background: #f7dcd7;
}

/* --------------------------------- 列表行 --------------------------------- */

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.row:last-child {
  border-bottom: 0;
}

.row__main {
  flex: 1;
  min-width: 0;
}

.row__title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row__sub {
  margin-top: 6rpx;
  color: var(--c-ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.row__value {
  flex: 0 0 auto;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
}

.row__arrow {
  flex: 0 0 auto;
  color: var(--c-ink-3);
  font-size: 32rpx;
}

.avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  color: #fdf8ec;
  font-size: 30rpx;
  font-weight: 700;
  background: var(--c-primary);
  border-radius: 50% 50% 50% 20rpx;
}

.avatar--accent {
  background: var(--c-accent);
}

/* --------------------------------- 网格 --------------------------------- */

.grid {
  display: grid;
  gap: 16rpx;
}

.grid--2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid--3 {
  grid-template-columns: repeat(3, 1fr);
}

.metric {
  padding: 24rpx 20rpx;
  background: var(--c-surface);
  border: 2rpx solid var(--c-line);
  border-radius: var(--r-md);
}

.metric__value {
  display: block;
  color: var(--c-primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}

.metric__label {
  display: block;
  margin-top: 10rpx;
  color: var(--c-ink-2);
  font-size: 22rpx;
}

.metric.is-alert .metric__value {
  color: var(--c-accent);
}

/* --------------------------------- 表单 --------------------------------- */

.field {
  margin-bottom: 24rpx;
}

.field__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.field__hint {
  margin-top: 12rpx;
  color: var(--c-ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.field__ok {
  margin-top: 12rpx;
  color: var(--c-success);
  font-size: 24rpx;
  font-weight: 600;
}

.field__error {
  margin-top: 12rpx;
  color: var(--c-danger);
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker-field {
  width: 100%;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: var(--c-ink);
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: var(--r-md);
}

.textarea {
  min-height: 168rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-field__placeholder {
  color: var(--c-ink-3);
}

/* ------------------------------- 绑定码输入 ------------------------------- */

.code-input {
  width: 100%;
  padding: 28rpx 24rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-align: center;
  background: #fff;
  border: 4rpx solid var(--c-line);
  border-radius: var(--r-md);
}

.code-input.is-valid {
  background: #f6fbf4;
  border-color: var(--c-primary);
}

.code-input.is-invalid {
  background: #fff6f4;
  border-color: var(--c-danger);
}

.code-input__placeholder {
  color: #cfc7b6;
  letter-spacing: 0.18em;
}

.code-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  background: var(--c-primary-soft);
  border-radius: var(--r-md);
}

/* 管理端展示学生绑定码的牌子 —— 老师抄给家长的那张"纸条" */
.code-plate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  color: #fdf8ec;
  background: linear-gradient(135deg, #2f5b45, #3d7358);
  border-radius: var(--r-md);
}

.code-plate.is-disabled {
  background: #8d9a90;
}

.code-plate__label {
  font-size: 22rpx;
  opacity: 0.8;
}

.code-plate__code {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.14em;
}

/* --------------------------------- 登录页 --------------------------------- */

.login {
  min-height: 100vh;
  padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #2f5b45 0%, #2f5b45 380rpx, #efe9dc 380rpx);
}

.login__brand {
  padding: 68rpx 0 52rpx;
  color: #fdf8ec;
}

.login__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 28rpx;
  color: #2f5b45;
  font-size: 52rpx;
  font-weight: 700;
  background: var(--c-gold);
  border-radius: 32rpx 32rpx 32rpx 10rpx;
  transform: rotate(-4deg);
}

.login__title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.login__sub {
  margin-top: 12rpx;
  color: #cfe0cb;
  font-size: 26rpx;
}

.login__card {
  padding: 36rpx 32rpx 40rpx;
  background: var(--c-surface);
  border: 2rpx solid var(--c-line);
  border-radius: var(--r-lg);
  box-shadow: 0 24rpx 60rpx rgba(39, 51, 45, 0.1);
}

.login__switch {
  display: flex;
  gap: 8rpx;
  margin-top: 32rpx;
  padding: 8rpx;
  background: var(--c-surface-2);
  border-radius: var(--r-md);
}

.login__switch-item {
  flex: 1;
  padding: 18rpx 0;
  color: var(--c-ink-2);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 20rpx;
}

.login__switch-item.is-active {
  color: var(--c-primary);
  background: var(--c-surface);
  box-shadow: 0 2rpx 8rpx rgba(39, 51, 45, 0.1);
}

/* --------------------------------- 弹层 --------------------------------- */

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 500;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(30, 38, 32, 0.45);
}

.mask--center {
  align-items: center;
}

.sheet {
  width: 100%;
  max-height: 84vh;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background: var(--c-surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
}

.sheet__title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.dialog {
  width: 620rpx;
  padding: 40rpx 36rpx 28rpx;
  text-align: center;
  background: var(--c-surface);
  border-radius: var(--r-lg);
}

.dialog__title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.dialog__body {
  margin-bottom: 32rpx;
  color: var(--c-ink-2);
  font-size: 26rpx;
  line-height: 1.7;
}

/* --------------------------------- 杂项 --------------------------------- */

.hero {
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #fdf8ec;
  background: linear-gradient(135deg, #2f5b45, #3f7359);
  border-radius: var(--r-lg);
}

.hero__label {
  font-size: 24rpx;
  opacity: 0.85;
}

.hero__value {
  display: block;
  margin-top: 8rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero__foot {
  display: flex;
  gap: 28rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 多孩家庭的切换条 */
.picker {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.picker__item {
  flex: 0 0 auto;
  padding: 14rpx 26rpx;
  color: var(--c-ink-2);
  font-size: 26rpx;
  font-weight: 600;
  background: var(--c-surface);
  border: 2rpx solid var(--c-line);
  border-radius: 999rpx;
}

.picker__item.is-active {
  color: #fdf8ec;
  background: var(--c-primary);
  border-color: var(--c-primary);
}

.rank {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.rank:last-child {
  border-bottom: 0;
}

.rank__no {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: var(--c-ink-2);
  font-size: 26rpx;
  font-weight: 700;
  background: var(--c-surface-2);
  border-radius: 18rpx;
}

.rank--top1 .rank__no {
  color: #7a5a12;
  background: var(--c-gold);
}

.rank--top2 .rank__no,
.rank--top3 .rank__no {
  color: #fff;
  background: #b6a88c;
}

.rank.is-self {
  padding-right: 16rpx;
  padding-left: 16rpx;
  background: #f4f9f1;
  border-radius: 20rpx;
}

.ledger__delta {
  font-size: 32rpx;
  font-weight: 700;
}

.ledger__delta.is-plus {
  color: var(--c-success);
}

.ledger__delta.is-minus {
  color: var(--c-accent);
}

/* 被冲正的记录：保留但划掉，绝不删除 */
.is-reversed {
  color: var(--c-ink-3);
  text-decoration: line-through;
}

.thumb {
  width: 100%;
  height: 360rpx;
  margin-top: 16rpx;
  border-radius: var(--r-md);
}

.thumb--sm {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  margin: 0;
}

.divider {
  height: 2rpx;
  margin: 24rpx 0;
  background: var(--c-line);
}

.text-muted {
  color: var(--c-ink-2);
}

.text-small {
  font-size: 24rpx;
}

.mono {
  letter-spacing: 0.08em;
}

.stack {
  display: grid;
  gap: 16rpx;
}

.inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.spread {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.full {
  width: 100%;
}

/* 开关：设置页用 */
.switch {
  position: relative;
  flex: 0 0 auto;
  width: 88rpx;
  height: 52rpx;
  background: #cfc7b6;
  border-radius: 999rpx;
  transition: background 0.16s;
}

.switch.is-on {
  background: var(--c-primary);
}

.switch::after {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  content: "";
  background: #fff;
  border-radius: 50%;
  transition: transform 0.16s;
}

.switch.is-on::after {
  transform: translateX(36rpx);
}
