<!-- 底部导航条：文字 + 线性 SVG 图标，按身份显示两套四项 -->
<view class="tabbar">
  <view
    class="tabbar__item {{index === active ? 'is-active' : ''}}"
    wx:for="{{items}}"
    wx:key="path"
    data-index="{{index}}"
    bindtap="onTap"
    hover-class="tabbar__item--hover"
    hover-stay-time="80"
  >
    <view class="tabbar__icon ico-{{item.icon}}"></view>
    <view class="tabbar__text">{{item.text}}</view>
  </view>
</view>
