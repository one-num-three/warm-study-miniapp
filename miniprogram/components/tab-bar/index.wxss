/**
 * 底部导航条样式。
 *
 * 图标是内联的线性 SVG data URI（stroke 版本，粗细 1.7），
 * 未选中 #9aa79d、选中 #2f5b45，因此每个图标写两条规则。
 * 用 background-image 而不是 <image src>：WXSS 的 data URI 在真机和开发者工具上表现都稳定，
 * <image> 组件对 SVG 的支持在部分基础库版本上有差异。
 *
 * 注意：本文件里的 data URI 是按 h5/src/icons.ts 的路径生成的，
 * 两端图标保持同一套，改图标请两边一起改。
 */

.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffaf0;
  border-top: 2rpx solid #e3d8c2;
}

.tabbar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  color: #9aa79d;
  font-size: 22rpx;
}

.tabbar__item--hover {
  opacity: 0.7;
}

.tabbar__item.is-active {
  color: #2f5b45;
  font-weight: 700;
}

.tabbar__icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.tabbar__text {
  line-height: 1.2;
}

