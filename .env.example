# 暖芽辅导班环境变量模板
# 真实值只放本机 .env 或部署平台密钥管理，不要提交真实密钥。

# 运行模式：本地开发使用 development，生产必须使用 production
NODE_ENV=development
PORT=8787

# 数据库路径。生产必须指向持久化磁盘；本地默认可留空。
WARM_STUDY_DB=

# 真实小程序凭据。开发时可留空，生产必须全部填写。
WARM_STUDY_WX_APPID=
WARM_STUDY_WX_SECRET=

# 上线后保持不变的高强度随机盐值；更换会导致既有 OpenID 哈希失配。
WARM_STUDY_IDENTITY_SALT=

# 发布目标：生产禁止自动灌入演示数据。当前服务尚未读取此项；完成安全
# bootstrap 后再启用，详见 docs/上线执行计划.md。
WARM_STUDY_SKIP_SEED=0

# 仅用于明确调用本地启动入口，生产不要打开。
WARM_STUDY_FORCE_START=0

# 计划中的生产安全配置（启用前需在 server/http.ts 接入）。
# WARM_STUDY_CORS_ORIGIN=https://你的-h5-域名.example.com
# WARM_STUDY_TRUSTED_PROXY=0
